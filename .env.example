# Paperrust — copy to a file you do not commit and fill in.
# Defaults are neutral: loopback only, empty lists, optional features off.
# An existing deployment keeps its current behavior only when the values below
# (the "current instance" column in the public-genericity notes) are set.

# --- Required ---

# Postgres URL. The API refuses to start without it.
DATABASE_URL=postgres://paperrust:paperrust@127.0.0.1:5432/paperrust?sslmode=disable

# HMAC for session cookies. At least 32 characters.
SESSION_SECRET=replace-with-32-or-more-random-characters

# 32-byte key, 64 hex chars or standard base64. Encrypts per-user LLM keys.
# openssl rand -hex 32
PAPERRUST_LLM_KEY_ENCRYPTION_KEY=

# --- Bind ---

# Default when unset: 127.0.0.1:8788
# Any explicit IPv4 is accepted. 0.0.0.0 needs the gate below.
PAPERRUST_BIND=127.0.0.1:8788

# Allow 0.0.0.0. PAPERRUST_BIND_K8S=1 is an alias of this flag.
PAPERRUST_BIND_ALLOW_UNSPECIFIED=
# PAPERRUST_BIND_K8S=

# production | beta | (empty). production refuses PAPERRUST_DEV and Vite CORS.
PAPERRUST_ENV=

# --- Public origins and OIDC ---

# Comma-separated browser origins, no paths: every origin this archive answers on.
# Redirect URI is {matched origin}/api/auth/callback, or the first origin when
# the Host is not in this list (loopback stays http://127.0.0.1:8788).
# By default each origin is public: only a loopback TCP peer (a tunnel sidecar
# or a reverse proxy on 127.0.0.1) may present it; any other peer gets 400.
PAPERRUST_PUBLIC_URLS=

# Subset of PAPERRUST_PUBLIC_URLS that any TCP peer may present in Host:
# origins reached directly or through a reverse proxy that is not on loopback
# (for example ingress-nginx). Restrict who can reach the port (firewall,
# NetworkPolicy). Every entry must be in PAPERRUST_PUBLIC_URLS, or startup stops.
# Empty: no such origin (fail-closed).
PAPERRUST_LAN_URLS=

# origin=issuer pairs, comma-separated. Issuer may include a path.
# The issuer plays no part in the public/LAN split (PAPERRUST_LAN_URLS does).
# Every origin here must also be in PAPERRUST_PUBLIC_URLS; a malformed entry
# stops startup. A public Host from an untrusted peer gets 400 (never remapped).
PAPERRUST_OIDC_ISSUERS=

# Loopback issuer, and the issuer for any host that is not in the map.
PAPERRUST_OIDC_ISSUER=

# Web OIDC client. Unset = login disabled.
PAPERRUST_OIDC_CLIENT_ID=
PAPERRUST_OIDC_CLIENT_SECRET=

# PEM file. When set, it is added to the trust store for every OIDC request
# (and for Stirling, unless PAPERRUST_STIRLING_CA_BUNDLE is set). No hostname
# detection. Unset = system roots only.
PAPERRUST_OIDC_CA_BUNDLE=

# Optional mobile Bearer issuers. Unset = Bearer mobile disabled.
PAPERRUST_OIDC_MOBILE_ISSUER=
PAPERRUST_OIDC_MOBILE_ISSUER_LAN=
PAPERRUST_OIDC_MOBILE_CLIENT_ID=

# --- CORS ---

# Exact browser origins allowed on the API (credentials). Default: none.
# Vite loopback origins stay allowed outside PAPERRUST_ENV=production.
PAPERRUST_CORS_ORIGINS=

# --- Stirling PDF (empty = integration off) ---

# Browser editor for public origins.
PAPERRUST_STIRLING_URL=
# Browser editor for direct/LAN origins. PAPERRUST_STIRLING_URL_LAN is the
# historical name; there is no second alias.
PAPERRUST_STIRLING_URL_LAN=
# Extra exact hosts allowed in addition to the hosts of the URLs above.
PAPERRUST_STIRLING_EXTRA_HOSTS=
# Server-to-server base. Falls back to the LAN URL, then the public URL.
# Inside Kubernetes, the in-cluster Service is used when this is unset.
PAPERRUST_STIRLING_API_URL=
PAPERRUST_STIRLING_API_KEY=
PAPERRUST_STIRLING_CA_BUNDLE=

# --- First user ---

# Off unless PAPERRUST_BOOTSTRAP=1. All three values must be set together.
# Creates user 1 when no user exists. Rewrites an existing user 1 only while it
# is an unclaimed "bootstrap:" subject that never logged in, at most once, and
# logs it. An OIDC token carrying a "bootstrap:" subject is always refused.
# Put these in a secret, not a config map.
PAPERRUST_BOOTSTRAP=
PAPERRUST_BOOTSTRAP_EMAIL=
PAPERRUST_BOOTSTRAP_NAME=
PAPERRUST_BOOTSTRAP_SUBJECT=

# --- OCR ---

# xAI model id. Unset uses the public default grok-4.5.
# PAPERRUST_XAI_MODEL=
# xAI base URL. Unset uses https://api.x.ai/v1. Do not put a key here.
# A private or cleartext URL is refused. A missing per-user key leaves OCR off.
# PAPERRUST_XAI_BASE_URL=
# Shared env keys are read only when this is 1. Leave unset.
# PAPERRUST_LLM_ENV_FALLBACK=

# --- Other ---

# UI directory. The container image sets /app/dist.
# PAPERRUST_UI_DIR=
# PAPERRUST_PDFIUM=
# PAPERRUST_DEV=1   # loopback binds only; refused when ENV=production
